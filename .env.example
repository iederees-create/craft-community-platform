# Tuftlings community platform — environment variables
# Copy to .env.local for local development. Never commit .env.local.

# Public Supabase project URL and anon key — safe to expose to the browser.
# Find these in Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key. NEVER expose this to the browser or commit it.
# Used only in server actions / route handlers for admin verification of
# purchase claims, moderation actions, and other privileged writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Etsy API credentials for purchase-claim verification.
# If unset, purchase claims fall back to manual admin verification.
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Base URL of this app, used for building absolute links in emails/notifications.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
